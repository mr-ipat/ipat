# Documentation only. One exact customer Host per issuer instance.
IPAT_R970_OIDC_ISSUER_SERVICE=YES
IPAT_TRUSTED_HTTPS_EDGE=YES
IPAT_R970_VERIFIED_CONFIDENTIAL_IDP=YES
IPAT_R971_DURABLE_PENDING=YES
IPAT_R992_TENANT_OIDC_PORT=31001
IPAT_R970_ISSUER=https://idp.example.invalid/realms/customer
IPAT_R970_HOST=portal.customer.invalid
IPAT_R970_CLIENT_ID=replace-with-reviewed-client
IPAT_R970_CLIENT_SECRET_FILE=/var/lib/ipat-tenant-oidc/secrets/INSTANCE/client-secret
IPAT_R970_PUBLIC_KEY_FILE=/var/lib/ipat-tenant-oidc/secrets/INSTANCE/idp-public.pem
IPAT_R970_KID=replace-with-pinned-key-id
IPAT_R970_DB_USER=ipat_oidc_session_issuer_login
IPAT_R970_DB_NAME=ipat_prod
IPAT_R970_DB_SOCKET=/run/postgresql
