# R9.93 exact customer-owned Host HTTPS ingress. Render __HOST__, __INSTANCE__, __OIDC_PORT__.
server {
    listen 80;
    server_name __HOST__;
    if ($host != "__HOST__") { return 421; }

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/ipat/acme-webroot;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
    }

    location / { return 308 https://__HOST__$request_uri; }
}

server {
    listen 443 ssl;
    server_name __HOST__;
    if ($host != "__HOST__") { return 421; }

    ssl_certificate /etc/letsencrypt/live/ipat-tenant-__INSTANCE__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ipat-tenant-__INSTANCE__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    location ^~ /auth/oidc/ {
        proxy_pass http://127.0.0.1:__OIDC_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host __HOST__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
    }

    location / {
        proxy_pass http://127.0.0.1:3003;
        proxy_http_version 1.1;
        proxy_set_header Host __HOST__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
    }
}
