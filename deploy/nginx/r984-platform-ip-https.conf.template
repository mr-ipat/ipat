# R9.84 exact temporary IPv4 Platform Owner trusted HTTPS edge.
server {
    listen 80 default_server;
    server_name __IP__;
    if ($host != "__IP__") { return 421; }

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/ipat/acme-webroot;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
    }

    location / { return 308 https://__IP__$request_uri; }
}

server {
    listen 443 ssl default_server;
    server_name __IP__;
    if ($host != "__IP__") { return 421; }

    ssl_certificate /etc/letsencrypt/live/ipat-platform-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ipat-platform-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    location ^~ /platform/auth/oidc/ {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;
        proxy_set_header Host __IP__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
    }

    location / {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Host __IP__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
    }
}
